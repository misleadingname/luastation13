{
	"$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
	"workspace": {
		"library": "${3rd}/love2d/library"
	},
	"diagnostics": {
		"globals": [
		],
		"disable": [
			"duplicate-set-field"
		]
	},
	"runtime": {
		"version": "LuaJIT",
		"nonstandardSymbol": [
			"+=",
			"-=",
			"/=",
			"*=",
			"%=",
			"//=",
			"^=",
			"continue"
		]
	}
}
